# AI Conf 2025 registration page — copy to .env.local and fill in.
# Both values come from the NEW aiconf-demo Supabase project: Settings > API.
# Do NOT use the production project cunsawtvsyxiqrgtlulr.
#
# Both are public by design: they ship in the browser bundle, which is why the
# NEXT_PUBLIC_ prefix is correct here and not a mistake. The security boundary
# is the RLS policy on `registrations` (anon may INSERT, nobody may SELECT),
# not the secrecy of these strings. See supabase/migrations/0001_registrations.sql.
#
# The service_role key must NEVER appear in this file, in the repo, or in an
# issue comment. It bypasses RLS entirely and would make every policy
# decorative. This app has no server-side path that needs it.
#
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME, not read at runtime. Changing
# them requires a rebuild and redeploy — restarting the server is not enough.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same two values, unprefixed, for supabase/verify.mjs (a plain node script, so
# it does not read NEXT_PUBLIC_ vars through Next's build step):
#   SUPABASE_URL=... SUPABASE_ANON_KEY=... node supabase/verify.mjs
